# Nyx language files - mark as vendored since Linguist doesn't know Nyx yet
# This ensures they're counted but as "Nyx" (shown as Text/unknown)
*.nx linguist-vendored
*.ny linguist-vendored

# Exclude C runtime implementation from language stats
native/* linguist-vendored
compiler_stage* linguist-vendored
output* linguist-vendored

# Exclude build artifacts
*.exe linguist-vendored
*.vsix linguist-vendored
*.zip linguist-vendored

# Exclude build tools/scripts (Python, PowerShell, Shell, JS)
scripts/*.ps1 linguist-vendored
scripts/*.sh linguist-vendored
src/*.py linguist-vendored
*.js linguist-vendored
package.json linguist-vendored

# Exclude documentation
*.md linguist-vendored
LICENSE linguist-vendored

# Keep editor extension TypeScript (it's part of the language distribution)
